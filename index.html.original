                  <span class="drive-badge"><i class="fa-solid fa-plane"></i> Langstreckenflug VIE → SYD</span>
                </div>
                <button type="button" class="btn-day-map-link btn-unified-map-link" onclick="focusDayOnMap(1, event)"
                  title="Tag 1 auf der Karte zentrieren &amp; Route anzeigen"><i
                    class="fa-solid fa-map-location-dot"></i> Auf Karte</button>
                <span class="expand-trigger"><i class="fa-solid fa-chevron-down"></i> Details</span>
