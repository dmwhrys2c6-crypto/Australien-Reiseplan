                  <div class="activity-inline-form">
                    <input type="time" class="act-time-input" id="act-time-day-1"
                      aria-label="Uhrzeit für neue Aktivität">
                    <input type="text" class="act-desc-input" id="act-desc-day-1"
                      placeholder="Neue Aktivität eintragen (z. B. 15:30 Eis essen)..."
                      onkeypress="if(event.key==='Enter') addCustomActivity(1)">
                    <button type="button" class="btn-act-add" onclick="addCustomActivity(1)"
                      title="Aktivität für Tag 1 hinzufügen">
                      <i class="fa-solid fa-plus"></i> Hinzufügen
                    </button>
                  </div>
                </div>
              </details>
              <div class="day-subcard budget">
                <div class="subcard-title"><i class="fa-solid fa-wallet"></i> Budget & Kosten</div>
                <ul class="sub-item-list">
                  <li><span>Langstreckenflug Wien → Sydney (p.P.):</span> <strong>453 €</strong> <span
                      class="status-pill paid">Bezahlt</span></li>
                </ul>
              </div>
              <div class="day-subcard hotel">
                <div class="subcard-title"><i class="fa-solid fa-plane"></i> Fluginformationen</div>
                <p><strong>Scoot - Economy Class - Boeing 787 - TR 12 / Abflug um 10:00 Uhr</strong></p>
                <span class="status-pill paid" style="margin-top:0.4rem; display:inline-block;"><i
                    class="fa-solid fa-check"></i> Flug gebucht & bezahlt</span>
              </div>
              <div class="day-subcard suggestions" data-day="2027-03-21">
