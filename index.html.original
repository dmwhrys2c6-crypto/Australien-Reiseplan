    <!-- 3b. Reiseorganisation: Buchungen & Packliste -->
    <section id="organization" class="section-spaced org-section">
      <div class="org-section-header">
        <div class="org-header-left">
          <div class="org-icon-badge"><i class="fa-solid fa-clipboard-list"></i></div>
          <div>
            <h2 class="section-title" style="margin-bottom:0.25rem;">Reiseorganisation &amp; Buchungs-Zentrale</h2>
            <p class="section-subtitle" style="margin:0;">Zentrale Verwaltung aller Flüge, Unterkünfte, Mietwagen,
              Touren &amp; deiner interaktiven Australien-Packliste</p>
          </div>
        </div>
      </div>

      <!-- Tab Switcher -->
      <div class="org-subnav-tabs" role="tablist">
        <button type="button" id="org-tab-btn-bookings" class="org-tab-btn active" role="tab" aria-selected="true"
          onclick="switchOrgTab('bookings')">
          <i class="fa-solid fa-receipt"></i>
          <span>Buchungen &amp; Voucher</span>
          <span class="org-tab-badge" id="org-badge-bookings-count">0</span>
        </button>
        <button type="button" id="org-tab-btn-packing" class="org-tab-btn" role="tab" aria-selected="false"
          onclick="switchOrgTab('packing')">
          <i class="fa-solid fa-suitcase-rolling"></i>
          <span>Interaktive Packliste</span>
          <span class="org-tab-badge" id="org-badge-packing-progress">0/55 · 0%</span>
        </button>
      </div>

      <!-- TAB PANEL 1: BUCHUNGEN -->
      <div id="org-panel-bookings" class="org-tab-panel active" role="tabpanel">
        <div class="org-controls-bar">
          <div class="org-filter-group">
            <div class="org-search-box">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input type="text" id="org-booking-search" class="org-search-input"
                placeholder="Buchung, Ort oder Ref suchen..." oninput="renderBookings()" autocomplete="off">
            </div>

            <select id="org-booking-filter-cat" class="org-select-filter" onchange="renderBookings()"
              aria-label="Nach Kategorie filtern">
              <option value="all">Alle Kategorien</option>
              <option value="flights">✈️ Flüge</option>
              <option value="hotels">🏨 Unterkünfte</option>
              <option value="car">🚗 Mietwagen &amp; Transport</option>
              <option value="activities">🥾 Aktivitäten &amp; Touren</option>
              <option value="camping">⛺ Camping &amp; Permits</option>
              <option value="misc">🎟️ Sonstiges &amp; Transfers</option>
            </select>

            <select id="org-booking-filter-day" class="org-select-filter" onchange="renderBookings()"
              aria-label="Nach Reisetag filtern">
              <option value="all">Alle Reisetage (1–20)</option>
              <option value="1">Tag 1: Flug Wien ➔ Sydney</option>
              <option value="2">Tag 2: Ankunft Sydney</option>
              <option value="3">Tag 3: Sydney City &amp; Bondi</option>
              <option value="4">Tag 4: Blue Mountains</option>
              <option value="5">Tag 5: Flug Ballina ➔ Byron Bay</option>
              <option value="6">Tag 6: Byron Bay &amp; Leuchtturm</option>
              <option value="7">Tag 7: Fahrt nach Brisbane</option>
              <option value="8">Tag 8: Brisbane City</option>
              <option value="9">Tag 9: Lone Pine Koala Sanctuary</option>
              <option value="10">Tag 10: Noosa National Park</option>
              <option value="11">Tag 11: Fahrt nach Hervey Bay</option>
              <option value="12">Tag 12: K’gari (Fraser Island) &amp; Nachtbus</option>
              <option value="13">Tag 13: Ankunft Airlie Beach</option>
              <option value="14">Tag 14: Whitsundays Katamaran</option>
              <option value="15">Tag 15: Helikopterflug Heart Reef</option>
              <option value="16">Tag 16: Flug nach Melbourne</option>
              <option value="17">Tag 17: Great Ocean Road (Teil 1)</option>
              <option value="18">Tag 18: Great Ocean Road (Teil 2)</option>
              <option value="19">Tag 19: Phillip Island &amp; Pinguine</option>
              <option value="20">Tag 20: Melbourne City &amp; Rückflug</option>
            </select>

            <select id="org-booking-sort" class="org-select-filter" onchange="renderBookings()" aria-label="Sortierung">
              <option value="day-asc">Sortierung: Reisetag (aufsteigend)</option>
              <option value="day-desc">Sortierung: Reisetag (absteigend)</option>
              <option value="cost-desc">Sortierung: Preis (höchster zuerst)</option>
              <option value="cost-asc">Sortierung: Preis (niedrigster zuerst)</option>
              <option value="name-asc">Sortierung: Name (A–Z)</option>
            </select>
          </div>

          <div class="org-controls-actions">
            <button type="button" class="btn-org-action primary" onclick="openBookingModal()">
              <i class="fa-solid fa-plus"></i> Buchung hinzufügen
            </button>
          </div>
        </div>

        <div class="org-summary-bar">
          <div><i class="fa-solid fa-receipt"></i> <span id="org-bookings-summary-count" class="org-summary-pill">18
              Buchungen</span> hinterlegt</div>
          <div><i class="fa-solid fa-coins"></i> Gesamtvolumen: <span id="org-bookings-summary-cost"
              class="org-summary-total">10.490 € (2.622,50 € p.P.)</span></div>
        </div>

        <div id="org-bookings-list-container" class="booking-cards-grid">
          <!-- Dynamisch per JavaScript generiert -->
        </div>
      </div>

      <!-- TAB PANEL 2: PACKLISTE -->
      <div id="org-panel-packing" class="org-tab-panel" role="tabpanel" style="display:none;">
        <!-- Fortschrittsanzeige -->
        <div class="packing-progress-card">
          <div class="packing-progress-header">
            <div class="packing-progress-title">
              <i class="fa-solid fa-list-check" style="color:var(--primary);"></i>
              <span>Pack-Fortschritt</span>
            </div>
            <div style="display:flex; align-items:center; gap:0.6rem;">
              <span id="org-packing-status-badge" class="packing-status-badge">
                <i class="fa-solid fa-spinner"></i> Koffer noch leer
              </span>
              <span id="org-packing-pct-text" class="packing-progress-score">0 / 55 (0%)</span>
            </div>
          </div>
          <div class="packing-progress-track">
            <div id="org-packing-progress-fill" class="packing-progress-fill" style="width:0%;"></div>
          </div>
          <div
            style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem; font-size:0.8rem; color:var(--text-muted);">
            <span><i class="fa-solid fa-shield-halved" style="color:var(--primary);"></i> Alle 10 Kategorien für den
              4-Personen Roadtrip optimiert</span>
            <span>Tippe auf ein Kästchen zum Abhaken</span>
          </div>
        </div>

        <!-- Filter Chips für Kategorien -->
        <div id="org-packing-chips-container" class="packing-chips-scroll">
          <!-- Dynamisch per JavaScript befüllt -->
        </div>

        <!-- Packliste Schnell-Aktionen -->
        <div class="org-controls-bar" style="margin-top:0.5rem;">
          <div class="org-controls-actions" style="width:100%; justify-content:space-between;">
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
              <button type="button" class="btn-org-action primary" onclick="openPackingModal()">
                <i class="fa-solid fa-plus"></i> Eigener Artikel
              </button>
              <button type="button" class="btn-org-action secondary" onclick="checkAllPackingList()">
                <i class="fa-solid fa-check-double"></i> Alle abhaken
              </button>
              <button type="button" class="btn-org-action secondary" onclick="resetPackingList()">
                <i class="fa-solid fa-rotate-left"></i> Zurücksetzen
              </button>
            </div>
            <button type="button" class="btn-org-action secondary" onclick="restoreDefaultPackingList()"
              title="Auf 55 Standard-Artikel zurücksetzen">
              <i class="fa-solid fa-arrow-rotate-left"></i> Standard wiederherstellen
            </button>
          </div>
        </div>

        <!-- Artikel Liste -->
        <div id="org-packing-list-container">
          <!-- Dynamisch gruppiert nach Kategorien per JavaScript generiert -->
        </div>
      </div>

      <!-- MODAL: BUCHUNG HINZUFÜGEN / BEARBEITEN -->
      <div id="booking-modal-backdrop" class="org-modal-backdrop"
        onclick="if(event.target === this) closeBookingModal()">
        <div class="org-modal" role="dialog" aria-modal="true" aria-labelledby="booking-modal-title-text">
          <div class="org-modal-header">
            <div class="org-modal-title">
              <i class="fa-solid fa-receipt" style="color:var(--primary);"></i>
              <span id="booking-modal-title-text">Buchung erfassen</span>
            </div>
            <button type="button" class="org-modal-close" onclick="closeBookingModal()" aria-label="Schließen">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <form id="booking-modal-form" onsubmit="saveBookingFromModal(event)">
            <input type="hidden" id="bkg-form-id" value="">

            <div class="org-form-grid">
              <div class="org-form-group">
                <label for="bkg-form-cat" class="org-form-label">Kategorie *</label>
                <select id="bkg-form-cat" class="org-form-select" required>
                  <option value="flights">✈️ Flüge</option>
                  <option value="hotels">🏨 Unterkünfte</option>
                  <option value="car">🚗 Mietwagen</option>
                  <option value="activities">🥾 Aktivitäten &amp; Touren</option>
                  <option value="camping">⛺ Camping &amp; Permits</option>
                  <option value="misc">🎟️ Sonstiges</option>
                </select>
              </div>

              <div class="org-form-group">
                <label for="bkg-form-day" class="org-form-label">Zugehöriger Reisetag</label>
                <select id="bkg-form-day" class="org-form-select">
                  <option value="0">Allgemein (Kein fester Tag)</option>
                  <option value="1">Tag 1 (21.03.2027)</option>
                  <option value="2">Tag 2 (22.03.2027)</option>
                  <option value="3">Tag 3 (23.03.2027)</option>
                  <option value="4">Tag 4 (24.03.2027)</option>
                  <option value="5">Tag 5 (25.03.2027)</option>
                  <option value="6">Tag 6 (26.03.2027)</option>
                  <option value="7">Tag 7 (27.03.2027)</option>
                  <option value="8">Tag 8 (28.03.2027)</option>
                  <option value="9">Tag 9 (29.03.2027)</option>
                  <option value="10">Tag 10 (30.03.2027)</option>
                  <option value="11">Tag 11 (31.03.2027)</option>
                  <option value="12">Tag 12 (01.04.2027)</option>
                  <option value="13">Tag 13 (02.04.2027)</option>
                  <option value="14">Tag 14 (03.04.2027)</option>
                  <option value="15">Tag 15 (04.04.2027)</option>
                  <option value="16">Tag 16 (05.04.2027)</option>
                  <option value="17">Tag 17 (06.04.2027)</option>
                  <option value="18">Tag 18 (07.04.2027)</option>
                  <option value="19">Tag 19 (08.04.2027)</option>
                  <option value="20">Tag 20 (09.04.2027)</option>
                </select>
              </div>

              <div class="org-form-group org-form-full">
                <label for="bkg-form-name" class="org-form-label">Name / Beschreibung *</label>
                <input type="text" id="bkg-form-name" class="org-form-input"
                  placeholder="z.B. Scoot TR 12 oder The Ultimo" required>
              </div>

              <div class="org-form-group">
                <label for="bkg-form-provider" class="org-form-label">Anbieter / Gesellschaft</label>
                <input type="text" id="bkg-form-provider" class="org-form-input"
                  placeholder="z.B. Virgin Australia, Booking.com">
              </div>

              <div class="org-form-group">
                <label for="bkg-form-ref" class="org-form-label">Buchungsnummer / Referenz</label>
                <input type="text" id="bkg-form-ref" class="org-form-input"
                  placeholder="z.B. VA1141-SYD oder BKG-99120">
              </div>

              <div class="org-form-group">
                <label for="bkg-form-date" class="org-form-label">Datum</label>
                <input type="date" id="bkg-form-date" class="org-form-input">
              </div>

              <div class="org-form-group">
                <label for="bkg-form-time" class="org-form-label">Uhrzeit</label>
                <input type="time" id="bkg-form-time" class="org-form-input">
              </div>

              <div class="org-form-group org-form-full">
                <label for="bkg-form-location" class="org-form-label">Ort / Adresse / Treffpunkt</label>
                <input type="text" id="bkg-form-location" class="org-form-input"
                  placeholder="z.B. 50 Jones St, Ultimo NSW oder Flughafen">
              </div>

              <div class="org-form-group">
                <label for="bkg-form-cost" class="org-form-label">Kosten (Gesamt für Gruppe)</label>
                <input type="number" id="bkg-form-cost" class="org-form-input" placeholder="0" min="0" step="0.01">
              </div>

              <div class="org-form-group">
                <label for="bkg-form-currency" class="org-form-label">Währung</label>
                <select id="bkg-form-currency" class="org-form-select">
                  <option value="EUR">EUR (€)</option>
                  <option value="AUD">AUD (A$)</option>
                </select>
              </div>

              <div class="org-form-group">
                <label for="bkg-form-status" class="org-form-label">Status</label>
                <select id="bkg-form-status" class="org-form-select">
                  <option value="confirmed">✅ Bestätigt &amp; Gebucht</option>
                  <option value="pending">⏳ In Planung / Reserviert</option>
                  <option value="optional">💡 Optional / Vormerkung</option>
                </select>
              </div>

              <div class="org-form-group">
                <label for="bkg-form-link" class="org-form-label">Link / Buchungs-URL</label>
                <input type="url" id="bkg-form-link" class="org-form-input" placeholder="https://...">
              </div>

              <div class="org-form-group org-form-full">
                <label for="bkg-form-notes" class="org-form-label">Notizen / Wichtige Hinweise</label>
                <textarea id="bkg-form-notes" class="org-form-textarea"
                  placeholder="z.B. Check-in Zeiten, Gepäckbestimmungen, Vollkasko ohne SB..."></textarea>
              </div>
            </div>

            <div class="org-modal-footer">
              <button type="button" id="bkg-modal-delete-btn" class="btn-org-action danger"
                onclick="confirmOrDeleteBookingFromModal(this)" style="display:none; margin-right:auto;">
                <i class="fa-solid fa-trash-can"></i> Buchung löschen
              </button>
              <button type="button" class="btn-org-action secondary" onclick="closeBookingModal()">Abbrechen</button>
              <button type="submit" class="btn-org-action primary"><i class="fa-solid fa-check"></i> Buchung
                speichern</button>
            </div>
          </form>
        </div>
      </div>

      <!-- MODAL: PACK-ARTIKEL HINZUFÜGEN -->
      <div id="packing-modal-backdrop" class="org-modal-backdrop"
        onclick="if(event.target === this) closePackingModal()">
        <div class="org-modal" role="dialog" aria-modal="true" aria-labelledby="packing-modal-title-text"
          style="max-width:440px;">
          <div class="org-modal-header">
            <div class="org-modal-title">
              <i class="fa-solid fa-plus-circle" style="color:var(--primary);"></i>
              <span id="packing-modal-title-text">Pack-Artikel hinzufügen</span>
            </div>
            <button type="button" class="org-modal-close" onclick="closePackingModal()" aria-label="Schließen">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <form id="packing-modal-form" onsubmit="savePackingItemFromModal(event)">
            <div class="org-form-group">
              <label for="pack-form-name" class="org-form-label">Artikel Bezeichnung *</label>
              <input type="text" id="pack-form-name" class="org-form-input"
                placeholder="z.B. Tauchmaske oder Zweite Sonnenbrille" required>
            </div>

            <div class="org-form-group">
              <label for="pack-form-cat" class="org-form-label">Kategorie *</label>
              <select id="pack-form-cat" class="org-form-select" required>
                <option value="clothing">👕 Kleidung</option>
                <option value="tech">🔌 Technik</option>
                <option value="camera">📷 Kamera</option>
                <option value="drone">🚁 Drohne</option>
                <option value="docs">📄 Dokumente</option>
                <option value="car">🚗 Auto</option>
                <option value="camping">⛺ Camping &amp; Strand</option>
                <option value="hygiene">🧴 Hygiene</option>
                <option value="meds">💊 Medikamente</option>
                <option value="misc">🧳 Sonstiges</option>
              </select>
            </div>

            <div class="org-form-group">
              <label for="pack-form-qty" class="org-form-label">Menge / Anzahl</label>
              <input type="text" id="pack-form-qty" class="org-form-input" placeholder="z.B. 1x, 2 Stück oder Set">
            </div>

            <div class="org-form-group">
              <label for="pack-form-note" class="org-form-label">Hinweis / Packtipp</label>
              <input type="text" id="pack-form-note" class="org-form-input"
                placeholder="z.B. Im Handgepäck transportieren">
            </div>

            <div class="org-modal-footer">
              <button type="button" class="btn-org-action secondary" onclick="closePackingModal()">Abbrechen</button>
              <button type="submit" class="btn-org-action primary"><i class="fa-solid fa-check"></i> Zur
                Packliste</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         REISEJOURNAL & FOTO-GALERIE
         ========================================================================= -->
    <section id="journal" class="section-spaced org-section journal-section">
      <div class="org-section-header">
        <div>
          <div class="org-section-badge"><i class="fa-solid fa-book-bookmark"></i> Tagebuch &amp; Momente</div>
          <h2 class="org-section-title">Reisejournal &amp; Foto-Galerie 📖📸</h2>
          <p class="org-section-subtitle">
            Persönliche Erlebnisse, Stimmungen, Highlights und Fotomomente – direkt verknüpft mit allen 20 Reisetagen.
          </p>
        </div>
      </div>

      <!-- Sub-Navigation Tabs: Journal vs. Fotos -->
      <div class="journal-tabs-wrap" role="tablist" aria-label="Journal und Foto-Navigation">
        <button type="button" class="journal-tab-btn active" id="journal-tab-btn-entries" role="tab"
          aria-selected="true" aria-controls="journal-panel-entries" onclick="switchJournalTab('entries')">
          <i class="fa-solid fa-book-open"></i>
          <span>Reisejournal</span>
          <span class="org-tab-count-badge" id="journal-entries-count-badge">20 Tage</span>
        </button>
        <button type="button" class="journal-tab-btn" id="journal-tab-btn-photos" role="tab" aria-selected="false"
          aria-controls="journal-panel-photos" onclick="switchJournalTab('photos')">
          <i class="fa-solid fa-camera-retro"></i>
          <span>Foto-Galerie &amp; Alben</span>
          <span class="org-tab-count-badge" id="photos-count-badge">10 Fotos</span>
        </button>
      </div>

      <!-- PANEL 1: REISEJOURNAL (20 TAGE) -->
      <div id="journal-panel-entries" class="journal-tab-panel" role="tabpanel"
        aria-labelledby="journal-tab-btn-entries">
        <!-- Reisetag-Wähler (Horizontaler Scroller für alle 20 Tage) -->
        <div class="journal-day-scroller" id="journal-day-scroller" role="tablist" aria-label="Reisetage Auswahl">
          <!-- Dynamically generated 20 Day Pills -->
        </div>

        <!-- Journal Content Grid: Links Tagesplan-Kontext, Rechts Journal-Editor -->
        <div class="journal-content-grid">
          <!-- Linke Spalte: Tagesplan & Routen-Kontext -->
          <div class="journal-day-info-card" id="journal-day-info-card">
            <!-- Dynamically populated from TRIP_DAYS_DATA -->
          </div>

          <!-- Rechte Spalte: Journal Editor -->
          <div class="journal-editor-card">
            <div class="journal-editor-top">
              <div class="journal-editor-title-wrap">
                <input type="text" id="journal-entry-title" class="org-form-input"
                  style="font-size:1.15rem; font-weight:800;" placeholder="Titel für diesen Tag eingeben..."
                  oninput="onJournalInput()">
              </div>
            </div>

            <!-- Mood / Stimmung Auswahl -->
            <div class="journal-mood-box">
              <label class="journal-mood-label"><i class="fa-solid fa-face-smile" style="color:var(--accent-gold);"></i>
                Heutige Stimmung &amp; Vibe:</label>
              <div class="journal-mood-grid" id="journal-mood-selector">
                <button type="button" class="journal-mood-chip" data-mood="🤩 Begeistert"
                  onclick="setJournalMood('🤩 Begeistert')">🤩 Begeistert</button>
                <button type="button" class="journal-mood-chip" data-mood="🤠 Abenteuerlustig"
                  onclick="setJournalMood('🤠 Abenteuerlustig')">🤠 Abenteuerlustig</button>
                <button type="button" class="journal-mood-chip" data-mood="🏖️ Tiefenentspannt"
                  onclick="setJournalMood('🏖️ Tiefenentspannt')">🏖️ Tiefenentspannt</button>
                <button type="button" class="journal-mood-chip" data-mood="🦘 Wildlife-Fieber"
                  onclick="setJournalMood('🦘 Wildlife-Fieber')">🦘 Wildlife-Fieber</button>
                <button type="button" class="journal-mood-chip" data-mood="😊 Glücklich"
                  onclick="setJournalMood('😊 Glücklich')">😊 Glücklich</button>
                <button type="button" class="journal-mood-chip" data-mood="😴 K.O. aber glücklich"
                  onclick="setJournalMood('😴 K.O. aber glücklich')">😴 K.O. aber glücklich</button>
                <button type="button" class="journal-mood-chip" data-mood="🌧️ Abenteuerlich"
                  onclick="setJournalMood('🌧️ Abenteuerlich')">🌧️ Abenteuerlich</button>
              </div>
            </div>

            <!-- Tagebuch Haupttext -->
            <div class="org-form-group">
              <label for="journal-entry-text" class="org-form-label"><i class="fa-solid fa-pen-nib"></i> Persönlicher
                Tagebucheintrag:</label>
              <textarea id="journal-entry-text" class="journal-textarea-main"
                placeholder="Was haben wir heute erlebt? Wie war die Fahrt? Welche Gerüche, Farben und Momente bleiben in Erinnerung?..."
                oninput="onJournalInput()"></textarea>
            </div>

            <!-- Zusätzliche Felder: Highlights & Besondere Erlebnisse -->
            <div class="journal-extra-grid">
              <div class="org-form-group">
                <label for="journal-entry-highlights" class="org-form-label"><i class="fa-solid fa-star"
                    style="color:var(--accent-gold);"></i> Highlights des Tages (kommagetrennt):</label>
                <input type="text" id="journal-entry-highlights" class="org-form-input"
                  placeholder="z.B. Erster Koala, Sonnenuntergang am Riff, Seafood Dinner" oninput="onJournalInput()">
              </div>
              <div class="org-form-group">
                <label for="journal-entry-special" class="org-form-label"><i class="fa-solid fa-heart"
                    style="color:#ec4899;"></i> Besondere Momente &amp; Anekdoten:</label>
                <input type="text" id="journal-entry-special" class="org-form-input"
                  placeholder="z.B. Flos legendärer Spruch beim Tanken..." oninput="onJournalInput()">
              </div>
            </div>

            <!-- Notizen & Links -->
            <div class="journal-extra-grid">
              <div class="org-form-group">
                <label for="journal-entry-notes" class="org-form-label"><i class="fa-solid fa-lightbulb"></i> Notizen
                  &amp; Tipps für später:</label>
                <input type="text" id="journal-entry-notes" class="org-form-input"
                  placeholder="z.B. Parkplatz früh anfahren, Mückenspray nicht vergessen" oninput="onJournalInput()">
              </div>
              <div class="org-form-group">
                <label for="journal-entry-links" class="org-form-label"><i class="fa-solid fa-link"></i> Optionale
                  Weblinks / Restaurant / Empfehlungen:</label>
                <input type="url" id="journal-entry-links" class="org-form-input" placeholder="https://..."
                  oninput="onJournalInput()">
              </div>
            </div>

            <!-- Bottom Actions -->
            <div class="journal-bottom-actions">
              <div class="journal-autosave-indicator" id="journal-autosave-indicator">
                <i class="fa-solid fa-check"></i> <span>Bereit</span>
              </div>
              <div class="journal-btn-group">
                <button type="button" class="btn-org-action danger" id="journal-delete-btn"
                  onclick="confirmOrDeleteJournalEntry(currentJournalDay, this)">
                  <i class="fa-solid fa-trash-can"></i> Eintrag leeren
                </button>
                <button type="button" class="btn-org-action primary" id="journal-save-btn"
                  onclick="saveJournalEntry(currentJournalDay, true)">
                  <i class="fa-solid fa-floppy-disk"></i> Eintrag speichern
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PANEL 2: FOTO-GALERIE & ALBEN -->
      <div id="journal-panel-photos" class="journal-tab-panel" role="tabpanel" aria-labelledby="journal-tab-btn-photos"
        style="display:none;">
        <!-- Banner: Geschütztes Google Album -->
        <div class="hub-card"
          style="margin-bottom:1.5rem; background:linear-gradient(135deg, rgba(0,119,182,0.1), rgba(16,185,129,0.08)); border:1px solid rgba(0,119,182,0.25);">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
            <div>
              <h3 style="margin:0 0 0.25rem 0; display:flex; align-items:center; gap:0.55rem; color:var(--primary);">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                Gemeinsames Gruppen-Fotoalbum (Originalqualität)
              </h3>
              <p style="font-size:0.85rem; color:var(--text-muted); margin:0;">
                Volle Auflösung, Videos und alle Rohdateien während der Reise live in das geschützte Google Photos Album
                laden:
              </p>
            </div>
            <a id="journal-photos-ext-btn" href="#" target="_blank" rel="noopener noreferrer"
              class="btn-org-action primary" style="text-decoration:none;">
              <i class="fa-solid fa-images"></i> Google Album öffnen
            </a>
          </div>
        </div>

        <!-- Filter & Add Bar -->
        <div class="photos-controls-bar">
          <div class="photos-filter-wrap">
            <label for="photos-filter-day" style="font-size:0.85rem; font-weight:700; color:var(--text-muted);"><i
                class="fa-solid fa-filter"></i> Nach Reisetag:</label>
            <select id="photos-filter-day" class="org-form-select" style="min-width:210px;"
              onchange="filterPhotosByDay(this.value)">
              <option value="all">Alle Fotos anzeigen</option>
              <!-- Populated dynamically: Tag 1 bis Tag 20 -->
            </select>
          </div>
          <button type="button" class="btn-org-action primary" onclick="openPhotoModal()">
            <i class="fa-solid fa-plus-circle"></i> Foto-Link hinzufügen
          </button>
        </div>

        <!-- Photos Grid -->
        <div class="photos-grid" id="photos-grid">
          <!-- Dynamically populated -->
        </div>
      </div>
    </section>

    <!-- 4. Tools & Private Links -->
    <section id="hub" class="section-spaced">
      <h2 class="section-title">Reise-Tools & Aussie-Helfer</h2>

      <div class="hub-layout-stack">

        <!-- Live Regenradar (Slide) -->
        <details class="clean-slide">
          <summary>
            <div class="slide-icon-title">
              <i class="fa-solid fa-cloud-bolt" style="color: #0284c7;"></i>
              <span>Live-Regenradar (Australien Ostküste) einblenden</span>
            </div>
            <i class="fa-solid fa-chevron-down chevron-rot"></i>
          </summary>
          <div class="slide-content" style="padding: 0; height: 380px;">
            <iframe style="width:100%; height:100%; border:none;"
              src="https://embed.windy.com/embed.html?type=map&location=coordinates&metricRain=mm&metricTemp=°C&metricWind=km/h&zoom=5&overlay=radar&product=radar&level=surface&lat=-28.5&lon=153.0"
              frameborder="0"></iframe>
          </div>
        </details>

        <!-- Maskiertes Gruppen-Tool: Live-Fotoalbum -->
        <div class="hub-card">
          <div
            style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.8rem;">
            <div>
              <h3 style="margin: 0 0 0.25rem 0; display: flex; align-items: center; gap: 0.55rem;">
                <i class="fa-solid fa-camera" style="color: var(--secondary);"></i>
                Live-Fotoalbum
              </h3>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
                Fotos & Videos während der Reise direkt für alle vier in voller Qualität hochladen:
              </p>
            </div>
            <div class="tool-btn-row" style="margin-top: 0;">
              <a id="link-photos" href="#" target="_blank" class="btn-tool photos" style="margin: 0;">
                <i class="fa-solid fa-images"></i> Geschütztes Google Album
              </a>
            </div>
          </div>
        </div>

        <!-- Checkin Cards Slide -->
        <details class="clean-slide" id="checkin-infocards-slide">
          <summary>
            <div class="slide-icon-title">
              <i class="fa-solid fa-hotel" style="color: var(--secondary);"></i>
              <span>Check-in Infocards (Alle Unterkünfte & Zeiten)</span>
            </div>
            <i class="fa-solid fa-chevron-down chevron-rot"></i>
          </summary>
          <div class="slide-content">
            <details class="checkin-card">
              <summary>The Ultimo, Sydney (22.03. – 25.03.) <i class="fa-solid fa-chevron-down"></i></summary>
              <div class="checkin-grid">
                <div><span class="label">Adresse</span>50 Jones St, Ultimo NSW 2007</div>
                <div><span class="label">Check-in ab</span>14:00 Uhr</div>
                <div><span class="label">Check-out bis</span>11:00 Uhr</div>
              </div>
            </details>
            <details class="checkin-card">
              <summary>AirBnB, East Ballina (25.03. – 27.03.) <i class="fa-solid fa-chevron-down"></i></summary>
              <div class="checkin-grid">
                <div><span class="label">Adresse</span>East Ballina, NSW</div>
                <div><span class="label">Check-in ab</span>15:00 Uhr</div>
                <div><span class="label">Check-out bis</span>10:00 Uhr</div>
              </div>
            </details>
            <details class="checkin-card">
              <summary>Rambla at Story House, Brisbane (27.03. – 30.03.) <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <div class="checkin-grid">
                <div><span class="label">Adresse</span>Brisbane City, QLD</div>
                <div><span class="label">Check-in ab</span>14:00 Uhr</div>
                <div><span class="label">Check-out bis</span>10:00 Uhr</div>
              </div>
            </details>
            <details class="checkin-card">
              <summary>Villa Noosa Hotel, Noosa (30.03. – 31.03.) <i class="fa-solid fa-chevron-down"></i></summary>
              <div class="checkin-grid">
                <div><span class="label">Adresse</span>Noosa Heads, QLD</div>
                <div><span class="label">Check-in ab</span>14:00 Uhr</div>
                <div><span class="label">Check-out bis</span>10:00 Uhr</div>
              </div>
            </details>
            <details class="checkin-card">
              <summary>Nightcap at Kondari Resort, Hervey Bay (31.03. – 01.04.) <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <div class="checkin-grid">
                <div><span class="label">Adresse</span>Hervey Bay, QLD</div>
                <div><span class="label">Check-in ab</span>14:00 Uhr</div>
                <div><span class="label">Check-out bis</span>10:00 Uhr</div>
              </div>
            </details>
            <details class="checkin-card">
              <summary>Coral Sea Vista Apartments, Airlie Beach (02.04. – 05.04.) <i
                  class="fa-solid fa-chevron-down"></i></summary>
              <div class="checkin-grid">
                <div><span class="label">Adresse</span>Airlie Beach, QLD</div>
                <div><span class="label">Check-in ab</span>14:00 Uhr</div>
                <div><span class="label">Check-out bis</span>10:00 Uhr</div>
              </div>
            </details>
            <details class="checkin-card">
              <summary>Vibe Hotel Docklands, Melbourne (05.04. – 09.04.) <i class="fa-solid fa-chevron-down"></i>
              </summary>
              <div class="checkin-grid">
                <div><span class="label">Adresse</span>Docklands, VIC</div>
                <div><span class="label">Check-in ab</span>14:00 Uhr</div>
                <div><span class="label">Check-out bis</span>11:00 Uhr</div>
              </div>
            </details>
          </div>
        </details>

      </div>
    </section>

    <!-- 4b. Drone Pilot Hub & Interactive Airspace Map -->
    <section id="drone-hub" class="section-spaced">
      <h2 class="section-title">Drone Pilot Hub 🛸</h2>
      <p class="section-lead">
        Offizielle Flugregeln, interaktive Luftraumzonen und Pre-Flight-Checkliste für den sicheren Drohneneinsatz (z.
        B. DJI Mini &lt; 250 g) entlang unserer Reiseroute durch New South Wales &amp; Queensland.
      </p>

      <!-- Pre-Flight Status Badge -->
      <div class="drone-status-banner">
        <div class="drone-status-icon">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <div class="drone-status-content">
          <div class="drone-status-title">Status: Private Hobby-Nutzung (&lt; 250 g) führerscheinfrei</div>
          <div class="drone-status-text">
            Für Freizeitflüge mit Minidrohnen unter 250 g ist in Australien <strong>weder Drohnenführerschein noch
              CASA-Registrierung</strong> nötig. Es gelten jedoch ausnahmslos die gesetzlichen Sicherheitsregeln und
            strikte No-Fly-Zones!
          </div>
        </div>
        <div class="drone-badge-sub250">&lt; 250 g Hobby-Klasse</div>
      </div>

      <!-- Interaktive Luftraum- & Flugzonenkarte (Akkordeon-Slide mit Lazy-Loading) -->
      <details class="clean-slide" id="drone-map-slide" ontoggle="handleDroneMapToggle(this)">
        <summary>
          <div class="slide-icon-title">
            <i class="fa-solid fa-map-location-dot" style="color: var(--primary);"></i>
            <span>🗺️ Interaktive Luftraum- &amp; Flugzonenkarte anzeigen</span>
          </div>
          <i class="fa-solid fa-chevron-down chevron-rot"></i>
        </summary>
        <div class="slide-content" style="padding: 1.25rem;">
          <div
            style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.8rem; margin-bottom: 1rem;">
            <div>
              <h3
                style="margin: 0; font-size: 1.05rem; color: var(--primary); display: flex; align-items: center; gap: 0.5rem;">
                <i class="fa-solid fa-crosshairs" style="color: var(--secondary);"></i>
                Interaktive Luftraum- &amp; Flugzonenkarte (Australien Ostküste)
              </h3>
              <span style="font-size: 0.78rem; color: var(--text-muted);">
                Wichtige No-Fly-Zonen, 5,5-km-Flughafenradien &amp; freigegebene Küsten-Spots
              </span>
            </div>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <button type="button" class="btn-drone-map-pill" onclick="locateDroneUserOnMap(event)"
                title="Meinen GPS-Standort auf der Karte verorten">
                <i class="fa-solid fa-location-crosshairs"></i> Mein GPS-Standort
              </button>
              <button type="button" class="btn-drone-map-pill" onclick="resetDroneMapView(event)"
                title="Kartenansicht auf Reiseroute zurücksetzen">
                <i class="fa-solid fa-rotate-left"></i> Route zentrieren
              </button>
            </div>
          </div>

          <!-- Transparenter Sicherheits- & Zuverlässigkeitshinweis zur Karte -->
          <div
            style="background: rgba(245, 158, 11, 0.08); border-left: 4px solid #f59e0b; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.82rem; color: var(--text-muted); line-height: 1.45;">
            <strong style="color: var(--text-main); display: block; margin-bottom: 0.2rem;">
              <i class="fa-solid fa-triangle-exclamation" style="color: #f59e0b;"></i> Zuverlässigkeit &amp; rechtlicher
              Status dieser Karte:
            </strong>
            Diese Karte dient der <strong>visuellen Vorab-Planung</strong> unserer Roadtrip-Route (große Nationalparks
            &amp; Verkehrsflughäfen). Sie enthält <strong>keine dynamischen Live-Luftraumdaten (NOTAMs, Rettungsflüge,
              temporäre Buschfeuer-Sperren)</strong> und keine lokalen Gemeinde-Verordnungen (Council Bylaws). Prüfe
            daher vor jedem Start vor Ort stets eine offizielle Smartphone-App (wie <em>OK2FLY</em> oder <em>OpenSky
              Wing</em>)!
          </div>

          <!-- Karten-Container (Leaflet, kein X-Frame-Block, flüssiges Rendering) -->
          <div style="position: relative; width: 100%;">
            <div id="drone-airspace-map"></div>
            <div class="drone-map-overlay-tip">
              <i class="fa-solid fa-satellite-dish"></i> CASA &amp; OpenStreetMap Luftraum-Explorer • Klicke auf Zonen
              für Details
            </div>
          </div>

          <!-- Kompakte Farb-Legende direkt unter der Karte -->
          <div class="drone-map-legend"
            style="margin-top: 1rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.85rem;">
            <div class="legend-card red-zone">
              <div class="legend-header">
                <i class="fa-solid fa-circle-exclamation" style="color: #ef4444;"></i>
                <strong>🔴 Rot (Strikte No-Fly-Zones)</strong>
              </div>
              <p>
                <strong>Nationalparks</strong> (K'gari / Fraser Island, Noosa NP, Blue Mountains, Whitsunday Island NP)
                sind ausnahmslos Flugverbotszonen (strenge Ranger-Kontrollen &amp; hohe Bußgelder!). Ebenso
                <strong>5,5-km-Sicherheitsradius</strong> um alle Flughäfen (Sydney SYD, Ballina BNK, Sunshine Coast
                MCY, Proserpine PPP, Melbourne MEL).
              </p>
            </div>

            <div class="legend-card yellow-zone">
              <div class="legend-header">
                <i class="fa-solid fa-triangle-exclamation" style="color: #f59e0b;"></i>
                <strong>🟡 Gelb (Vorsicht &amp; Auflagen)</strong>
              </div>
